---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import GridDownloads from "../components/GridDownloads.astro";
import TeamGrid from "../components/TeamGrid.astro";
import items from "../data/downloads";
import members from "../data/team";
import GridDocuments from "../components/GridDocuments.astro";
import documents from "../data/documents"; 
const docs = documents;
---

<BaseLayout title="Guía de Respaldo Preventivo">
  <Navbar />

  <section class="space-y-6">
    <section aria-labelledby="bienvenido" class="mx-auto max-w-6xl px-4 py-12">
  <div class="rounded-3xl border border-white/10 bg-white/5 p-8 md:p-10 backdrop-blur">
    <!-- Eyebrow + título -->
    <p class="text-sm font-bold tracking-wide text-transparent bg-clip-text bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">
      INICIO
    </p>
    <h2 id="bienvenido" class="mt-1 text-3xl md:text-4xl font-semibold leading-tight">
      Bienvenido
    </h2>
    <p class="mt-3 text-base md:text-lg leading-relaxed text-white/85">
      Esta plataforma ha sido diseñada específicamente para optimizar el proceso de preservación de productos
      finales, garantizando la integridad de la información y facilitando el trabajo colaborativo entre departamentos.
    </p>

    <!-- Puntos clave en tarjetas pequeñas -->
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
        <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full
                     text-xs text-white shadow-sm
                     bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">✓</span>
        <div>
          <h3 class="font-medium">Herramientas especializadas</h3>
          <p class="text-sm text-white/80">
            Desarrolladas por nuestro equipo técnico para tu flujo diario, con documentación y manuales listos.
          </p>
        </div>
      </li>

      <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
        <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full
                     text-xs text-white shadow-sm
                     bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">✓</span>
        <div>
          <h3 class="font-medium">Soluciones de terceros</h3>
          <p class="text-sm text-white/80">
            Integraciones seleccionadas para complementar y mejorar tus procesos de respaldo.
          </p>
        </div>
      </li>

      <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
        <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full
                     text-xs text-white shadow-sm
                     bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">✓</span>
        <div>
          <h3 class="font-medium">Equipo de especialistas</h3>
          <p class="text-sm text-white/80">
            Asesoramiento técnico directo para implementación, dudas e incidencias.
          </p>
        </div>
      </li>

      <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
        <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full
                     text-xs text-white shadow-sm
                     bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">✓</span>
        <div>
          <h3 class="font-medium">Protección e integridad</h3>
          <p class="text-sm text-white/80">
            Estándares altos para preservar y garantizar la calidad de tu información crítica.
          </p>
        </div>
      </li>
    </ul>

    <!-- Divider sutil -->
    <hr class="mt-8 h-px border-0 bg-gradient-to-r from-transparent via-white/25 to-transparent" />

    <!-- CTA / Atajos -->
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href="/boveda"
         class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/8 px-5 py-2.5 text-[15px]
                text-white/90 shadow-sm backdrop-blur transition hover:bg-white/12
                focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f041ff]/50">
        Probar Analizador HDD
      </a>
      <a href="/analyzer"
         class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-[15px]
                text-white/90 transition hover:bg-white/10">
        Probar Analyzer
      </a>

      <span class="ml-auto flex items-center gap-2 text-xs text-white/60">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#f041ff]"></span>
        Integridad • Colaboración • Eficiencia
      </span>
    </div>
  </div>
</section>

    <!-- Sección Equipo (refactorizada) -->
    <TeamGrid
      title="Equipo de Colaboradores"
      subtitle="Esta aplicación fue posible gracias al trabajo del siguiente equipo de desarrolladores:"
      members={members}
    />
    <!-- <FlexFrameworks active="React" /> -->
    <main class="mx-auto max-w-6xl px-4 py-10">
            
      <GridDownloads items={items} />

      <GridDocuments
        title="Documentos"
        subtitle="Accede a políticas, manuales, informes y minutas de todas las áreas."
        items={docs}
      />
    </main>
  </section>
</BaseLayout>

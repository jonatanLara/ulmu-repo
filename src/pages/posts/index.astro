---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";

const all = await getCollection("posts", ({ data }) => !data.draft);
const posts = all.sort((a, b) => +b.data.published - +a.data.published);
---
<BaseLayout title="ULMU – Posts" description="Manuales, tutoriales y guías">
  <Navbar />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-6">
      <p class="text-sm font-medium tracking-wide text-transparent bg-clip-text bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">
        Publicaciones
      </p>
      <h1 class="mt-1 text-3xl md:text-4xl font-semibold">Manuales y Guías</h1>
      <p class="mt-2 text-white/80">Documentación enriquecida escrita en Markdown.</p>
    </header>

    <!-- Buscador -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input id="q" type="search" placeholder="Buscar por título o etiqueta…"
             class="w-full sm:w-80 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm outline-none
                    focus:ring-2 focus:ring-[#f041ff]/40" />
      <span class="text-xs text-white/60">Total: <strong id="count">{posts.length}</strong></span>
    </div>

    <!-- Grid -->
    <ul id="list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map(p => (
        <li
          data-title={(p.data.title + " " + (p.data.tags || []).join(" ")).toLowerCase()}
          class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-[0_10px_40px_rgba(240,65,255,.18)] hover:ring-1 hover:ring-[#f041ff]/30"
        >
          {
          p.data.cover && <img 
            transition:name={`img-${p.slug}`}
            src={p.data.cover} 
            alt="" 
            class="mb-4 h-36 w-full rounded-xl object-cover" 
          />
          }
          <h3 class="text-lg font-semibold line-clamp-2">{p.data.title}</h3>
          {p.data.description && <p class="mt-1 text-sm text-white/80 line-clamp-3">{p.data.description}</p>}
          <div class="mt-3 flex flex-wrap gap-2">
            {(p.data.tags || []).map(t => (
              <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-xs">{t}</span>
            ))}
          </div>
          <a href={`/posts/${p.slug}/`}
             class="mt-4 inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/8 px-3 py-1.5 text-sm
                    text-white/90 shadow-sm backdrop-blur transition hover:bg-white/12 focus-visible:outline-none
                    focus-visible:ring-2 focus-visible:ring-[#f041ff]/50">Leer</a>
        </li>
      ))}
    </ul>
  </main>

  <script type="module">
    const q = document.getElementById("q");
    const list = document.getElementById("list");
    const count = document.getElementById("count");
    if (q && list) {
      q.addEventListener("input", () => {
        const term = q.value.trim().toLowerCase();
        let visible = 0;
        list.querySelectorAll("li[data-title]").forEach((li) => {
          const ok = !term || li.getAttribute("data-title").includes(term);
          li.classList.toggle("hidden", !ok);
          if (ok) visible++;
        });
        if (count) count.textContent = String(visible);
      });
    }
  </script>
</BaseLayout>

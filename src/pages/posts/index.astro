---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import TeamPopover from "../../components/TeamPopover.astro";
import members from "../../data/team";                     // tu lista global
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout title="Manuales y Guías – ULMU.Repo" description="Documentación enriquecida escrita en Markdown.">
  <Navbar />

  <!-- HERO -->
  <section class="relative mx-auto max-w-6xl px-4 pt-8 pb-4">
    <div class="pointer-events-none absolute inset-0 -z-10 rounded-b-[2rem] bg-[radial-gradient(1000px_300px_at_20%_-10%,#3b1c8d33,transparent),radial-gradient(1000px_300px_at_80%_-10%,#f041ff22,transparent)]"></div>

    <p class="text-sm font-medium text-transparent bg-clip-text bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">
      Publicaciones
    </p>
    <h1 class="mt-1 text-4xl md:text-5xl font-semibold tracking-tight">Manuales y Guías</h1>
    <p class="mt-2 text-white/80">Documentación enriquecida escrita en Markdown.</p>

    <!-- buscador + total -->
    <div class="mt-5 flex items-center gap-3">
      <input id="q" type="search" placeholder="Buscar por título o etiqueta..."
             class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/5 px-4 py-2 outline-none
                    focus:ring-2 focus:ring-[#f041ff]/40">
      <span class="text-sm text-white/70">Total: <strong id="tot">{posts.length}</strong></span>
    </div>
  </section>

  <!-- GRID DE TARJETAS -->
  <section class="mx-auto max-w-6xl px-4 pb-10">
    <ul id="grid" class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <li class="card group rounded-2xl border border-white/10 bg-white/5 shadow-xl backdrop-blur"
            data-title={(p.data.title + " " + (p.data.tags||[]).join(" ")).toLowerCase()}>
          <!-- imagen / cover -->
          {p.data.cover
            ? <img src={p.data.cover} alt="" class="h-40 w-full rounded-t-2xl object-cover"/>
            : <div class="h-40 w-full rounded-t-2xl bg-gradient-to-br from-white/10 to-white/5"></div>}
          <!-- cuerpo -->
          <div class="p-5">
            <h3 class="text-lg font-semibold">{p.data.title}</h3>
            {p.data.description && <p class="mt-1 text-sm text-white/80 line-clamp-2">{p.data.description}</p>}

            <!-- tags -->
            {(p.data.tags || []).length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {p.data.tags!.map((t) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-xs">{t}</span>
                ))}
              </div>
            )}

            <!-- acciones: Leer + TeamPopover (pequeño) -->
            <div class="mt-4 flex items-center justify-between">
              <a href={`/posts/${p.slug}/`}
                 class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-sm
                        transition hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f041ff]/40">
                Leer
              </a>

              <div class="shrink-0">
                <TeamPopover
                  members={members}
                  include={p.data.contributors || []}
                  size="xs"              
                  panelWidth={420}       
                  layer="body"           
                  expand="right"
                />
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- filtro client-side (opcional) -->
  <script is:inline>
    (() => {
      const q = document.getElementById('q');
      const grid = document.getElementById('grid');
      const tot = document.getElementById('tot');
      const items = Array.from(grid.querySelectorAll('.card'));
      function apply() {
        const term = (q.value || '').trim().toLowerCase();
        let visible = 0;
        items.forEach(li => {
          const hay = li.getAttribute('data-title') || '';
          const ok = !term || hay.includes(term);
          li.classList.toggle('hidden', !ok);
          if (ok) visible++;
        });
        tot.textContent = String(visible);
      }
      q?.addEventListener('input', apply);
    })();
  </script>
</BaseLayout>

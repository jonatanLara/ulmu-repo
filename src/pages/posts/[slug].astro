---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import TeamPopover from "../../components/TeamPopover.astro";
import members from "../../data/team";
import { getCollection, type CollectionEntry } from "astro:content";

/** Rutas */
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p as CollectionEntry<"posts"> },
  }));
}

/** Props */
const { post } = Astro.props as { post: CollectionEntry<"posts"> };
const { Content, headings } = await post.render();

const fmt = (d?: Date): string =>
  d ? new Date(d).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" }) : "";

// CTA opcional
type DownloadVar = { os: "Windows" | "macOS" | "Linux"; href: string; label?: string; size?: string };
type PostCta = {
  name?: string; store?: string; action?: string; icon?: string; badge?: string;
  websiteUrl?: string; downloadUrl?: string; downloads?: DownloadVar[];
};
const cta = (post.data as any).cta as PostCta | undefined;
---
<BaseLayout title={post.data.title + " – ULMU"} description={post.data.description || ""}>
  <Navbar />

  <article class="mx-auto max-w-3xl px-4 py-10">
    <a href="/posts" class="text-white/80 hover:underline opacity-70">← Volver atrás</a>
    <!-- sentinelas para scroll -->
    <div id="top-sentinel" class="h-1"></div>

    <header class="mb-6">
      <p class="text-xs text-white/60">
        Publicado:
        <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time>
        {post.data.updated && " · Actualizado: "}
        {post.data.updated && <time datetime={post.data.updated.toISOString()}>{fmt(post.data.updated)}</time>}
      </p>
      <div class="mt-1 flex items-start gap-3">
        <h1 class="text-3xl md:text-5xl font-semibold leading-tight">{post.data.title}</h1>

        <!-- TeamPopover pegado al título (tamaño pequeño) -->
        <div class="ml-auto pt-1">
          <TeamPopover
            members={members}
            include={post.data.contributors || []}
            size="sm"
            panelWidth={420}
            layer="body"  
            expand="right"
          />
        </div>
      </div>

      {post.data.description && <p class="mt-2 text-white/80">{post.data.description}</p>}
      {(post.data.tags || []).length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags!.map((t) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-xs">{t}</span>
          ))}
        </div>
      )}
      {post.data.cover && <img src={post.data.cover} alt="" class="mt-6 w-full rounded-2xl object-cover" />}
    </header>

    <div class="prose-ulmu">
      <Content />
    </div>
    {headings.length > 3 && (
      <aside class="mt-10 rounded-2xl border border-white/10 bg-white/5 p-4 text-sm">
        <p class="mb-2 font-medium">En esta guía</p>
        <ul class="space-y-1">
          {headings.map((h) => (
            <li class="pl-2" style={{ marginLeft: (h.depth - 2) * 12 + "px" }}>
              <a href={"#" + h.slug} class="text-white/80 hover:text-white">{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
   <a href="/posts" class="text-white/80 hover:underline opacity-70">← Volver atrás</a>
    <!-- sentinela cercano al footer (ocultar dock) -->
    <div id="bottom-sentinel" class="h-24"></div>
  </article>

  <!-- Dock flotante si hay CTA -->
  {cta && (cta.downloadUrl || cta.websiteUrl || (cta.downloads && cta.downloads.length)) && (
    <>
      <!-- Desktop -->
      <aside
        id="dock"
        class="fixed right-4 top-[30svh] z-40 hidden w-[340px] translate-y-4 opacity-0 pointer-events-none
               transition-[opacity,transform] duration-300 ease-out md:block"
        aria-live="polite"
      >
        <div class="dock-card relative rounded-2xl border border-white/15 bg-white/10 p-3 shadow-xl backdrop-blur">
          <!-- badge -->
          <div class="absolute -top-2 left-3 rounded-full bg-white/15 px-2 py-0.5 text-[11px] text-white/90 ring-1 ring-white/20">
            {cta.badge || "recurso"}
          </div>

          <div class="flex items-center gap-3">
            <div class="grid h-14 w-14 place-items-center rounded-xl ring-1 ring-white/20 bg-white/70">
              {cta.icon ? (
                <img src={cta.icon} alt="" class="h-8 w-8 object-contain" loading="lazy" decoding="async" />
              ) : (
                <span class="h-8 w-8 rounded-md bg-[linear-gradient(66.77deg,#d83333,#f041ff)]"></span>
              )}
            </div>
            <div class="min-w-0">
              <p class="flex items-center gap-1 text-[12px] text-white/70">
                <svg viewBox="0 0 24 24" class="h-4 w-4 opacity-80" fill="currentColor" aria-hidden="true">
                  <path d="M12 2 4 5v6c0 5 3.8 9.7 8 11 4.2-1.3 8-6 8-11V5l-8-3zM7 11l5 5 5-5-1.4-1.4L12 13.2 8.4 9.6 7 11z"/>
                </svg>
                {cta.store || "Sitio oficial"}
              </p>
              <h3 class="text-lg font-semibold leading-5 truncate">{cta.name || post.data.title}</h3>
              <p class="text-[12px] text-white/70 truncate">{cta.action || "Descarga disponible"}</p>
            </div>
          </div>

          <!-- Acciones -->
          <div class="mt-3 flex items-center gap-2">
            <!-- Botón de descarga (se ajusta por OS en runtime) -->
            <a id="dock-dl" href={cta.downloadUrl || cta.websiteUrl || "#"}
               class="inline-flex flex-1 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm font-medium
                      text-white shadow-md ring-1 ring-white/20 transition
                      bg-[linear-gradient(66.77deg,#d83333,#f041ff)] hover:brightness-110 focus-visible:outline-none
                      focus-visible:ring-2 focus-visible:ring-white/70">
              Descargar
            </a>

            <!-- Más opciones (otras plataformas) -->
            {((cta.downloads && cta.downloads.length > 1) || cta.websiteUrl) && (
              <details class="relative">
                <summary class="list-none cursor-pointer rounded-full border border-white/15 bg-white/10 px-3 py-2 text-sm
                                  text-white/90 transition hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f041ff]/40">
                  Opciones
                </summary>
                <ul class="absolute right-0 z-50 mt-2 w-44 overflow-hidden rounded-xl border border-white/10 bg-white/10 p-1 backdrop-blur">
                  {cta.downloads?.map((v) => (
                    <li>
                      <a href={v.href} class="block rounded-lg px-3 py-1.5 text-sm hover:bg-white/15">
                        {v.os}{v.label ? ` · ${v.label}` : ""}{v.size ? ` · ${v.size}` : ""}
                      </a>
                    </li>
                  ))}
                  {cta.websiteUrl && (
                    <li><a href={cta.websiteUrl} class="block rounded-lg px-3 py-1.5 text-sm hover:bg-white/15">Sitio</a></li>
                  )}
                </ul>
              </details>
            )}

            <button id="dock-close"
              class="ml-auto inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/10
                     text-white/80 transition hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f041ff]/40"
              aria-label="Cerrar sugerencia">✕</button>
          </div>
        </div>
      </aside>

      <!-- Móvil -->
      <aside
        id="dock-mobile"
        class="fixed inset-x-0 bottom-4 z-40 mx-4 translate-y-4 opacity-0 pointer-events-none
               rounded-2xl border border-white/15 bg-white/10 p-3 shadow-xl backdrop-blur
               transition-[opacity,transform] duration-300 ease-out md:hidden"
        aria-live="polite"
      >
        <div class="flex items-center gap-3">
          <div class="grid h-12 w-12 place-items-center rounded-xl ring-1 ring-white/20 bg-white/70">
            {cta.icon ? (
              <img src={cta.icon} alt="" class="h-7 w-7 object-contain" loading="lazy" decoding="async" />
            ) : (
              <span class="h-7 w-7 rounded-md bg-[linear-gradient(66.77deg,#d83333,#f041ff)]"></span>
            )}
          </div>
          <div class="min-w-0">
            <p class="text-[11px] text-white/70">{cta.store || "Sitio oficial"}</p>
            <p class="text-sm font-semibold truncate">{cta.name || post.data.title}</p>
          </div>
          <div class="ml-auto flex items-center gap-2">
            {cta.websiteUrl && (
              <a href={cta.websiteUrl}
                 class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs
                        text-white/90 transition hover:bg-white/15">Sitio</a>
            )}
            <a id="dockm-dl" href={cta.downloadUrl || cta.websiteUrl || "#"}
               class="inline-flex items-center justify-center rounded-full px-3 py-1.5 text-xs font-medium text-white
                      shadow ring-1 ring-white/20 transition bg-[linear-gradient(66.77deg,#d83333,#f041ff)] hover:brightness-110">
              Descargar
            </a>
            <button id="dockm-close"
              class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white/80">✕</button>
          </div>
        </div>
      </aside>

      <!-- Datos de variantes para JS -->
      <script type="application/json" id="dock-variants">{JSON.stringify(cta.downloads ?? [])}</script>

      <!-- LÓGICA: animación, scroll, footer y OS detection -->
      <script type="module">
        const dock = document.getElementById("dock");
        const dockm = document.getElementById("dock-mobile");
        const close = document.getElementById("dock-close");
        const closem = document.getElementById("dockm-close");
        const topSentinel = document.getElementById("top-sentinel");
        const bottomSentinel = document.getElementById("bottom-sentinel");
        const variants = (() => {
          try {
            return JSON.parse(document.getElementById("dock-variants")?.textContent || "[]");
          } catch { return []; }
        })();

        // Detección simple de OS
        function detectOS() {
          const p = (navigator.userAgentData?.platform || navigator.platform || navigator.userAgent || "").toLowerCase();
          if (p.includes("win")) return "Windows";
          if (p.includes("mac")) return "macOS";
          if (p.includes("linux")) return "Linux";
          return "";
        }
        const userOS = detectOS();

        // Selecciona el mejor href por OS
        function pickVariant(os) {
          const v = variants.find(x => x.os === os);
          return v || variants[0]; // fallback al primero
        }
        function setPrimaryButtons() {
          const target = userOS ? pickVariant(userOS) : variants[0];
          const dl = document.getElementById("dock-dl");
          const dlm = document.getElementById("dockm-dl");
          if (target?.href) {
            dl?.setAttribute("href", target.href);
            dlm?.setAttribute("href", target.href);
            const label = target.label ? "Descargar " + target.label : "Descargar";
            if (dl) dl.textContent = label;
            if (dlm) dlm.textContent = label;
          }
        }
        setPrimaryButtons();

        // Mostrar/ocultar por scroll
        let dismissed = false;
        function show(el) {
          if (!el) return;
          el.classList.remove("opacity-0","translate-y-4","pointer-events-none");
        }
        function hide(el) {
          if (!el) return;
          el.classList.add("opacity-0","translate-y-4","pointer-events-none");
        }

        // Cuando el tope del artículo sale de vista => mostrar
        if (topSentinel) {
          const obsTop = new IntersectionObserver(([entry]) => {
            if (dismissed) return;
            if (!entry.isIntersecting) { show(dock); show(dockm); }
            else { hide(dock); hide(dockm); }
          }, { rootMargin: "-80px 0px 0px 0px", threshold: 0 });
          obsTop.observe(topSentinel);
        }

        // Cuando el usuario se acerca al final (o aparece el footer) => ocultar
        const footer = document.querySelector("footer");
        const targetBottom = footer || bottomSentinel;
        if (targetBottom) {
          const obsBottom = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting) { hide(dock); hide(dockm); }
          }, { rootMargin: "0px 0px -20% 0px", threshold: 0 });
          obsBottom.observe(targetBottom);
        }

        // Cerrar manual
        close?.addEventListener("click", () => { dismissed = true; hide(dock); });
        closem?.addEventListener("click", () => { dismissed = true; hide(dockm); });
      </script>

      <!-- Animaciones (flotar + glow suave) -->
      <style is:global>
        @keyframes dock-float { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-4px) } }
        @keyframes dock-glow  { 0%,100%{ box-shadow: 0 8px 30px rgba(240,65,255,.12) }
                                 50%   { box-shadow: 0 14px 44px rgba(240,65,255,.22) } }
        .dock-card { animation: dock-float 6s ease-in-out infinite, dock-glow 3.6s ease-in-out infinite; }
        .dock-card:hover { animation-play-state: paused; } /* pausa al hover para foco del usuario */
      </style>
    </>
  )}
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="Bóveda de Respaldo">
  <Navbar />



  <section class="space-y-6">
    <!-- PON darkMode: 'class' en tailwind.config.js y añade class="dark" al <html> -->
    <!-- Contenido principal convertido a Tailwind en modo dark -->

    <!-- Header -->
    <header class="bg-gradient-to-r from-gray-bg-white/5 bg-white/5 text-white text-center py-10 ">
      <div class="max-w-6xl mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-bold mb-3">
          Guía de Usuario - Aplicación de Respaldo Preventivo
        </h1>
        <p class="text-gray-300">
          Procedimiento para el análisis y documentación de discos duros
        </p>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8 text-gray-200">

      <!-- Introducción -->
      <section id="inicio"
        class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 md:p-8 shadow-sm backdrop-blur mb-8">
        <!-- barra superior en gradiente -->
        <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-[linear-gradient(66.77deg,#d83333,#f041ff)]"></div>

        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight
                  text-transparent bg-clip-text bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">
          Introducción
        </h2>
        <div class="mt-2 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>

        <p class="mt-4 text-white/85 leading-relaxed">
          A mediados de 2024, se implementó una estrategia para realizar respaldos preventivos de los discos duros del proyecto.
          Esta iniciativa nació de la necesidad de gestionar eficientemente la información entregada para respaldo, sin conocer de antemano su contenido específico.
        </p>

        <p class="mt-3 text-white/85 leading-relaxed">
          La <span class="font-semibold text-white">primera versión de la aplicación</span> fue desarrollada exclusivamente para el área de sistemas.
          Dada su relevancia y beneficios para la organización, se decidió liberarla para todos los usuarios que la requieran.
        </p>

        <p class="mt-3 text-white/85 leading-relaxed">
          La aplicación genera un documento comparativo que permite reconocer archivos nuevos, facilitar actualizaciones posteriores
          y actuar como un mecanismo preventivo y correctivo.
        </p>
      </section>

      <!-- Equipo -->
      <section
        class="rounded-2xl border border-white/10 bg-white/5 text-white px-6 py-10 shadow-sm backdrop-blur mb-8">
        <h2 class="text-center text-2xl font-semibold tracking-tight
                  text-transparent bg-clip-text bg-[linear-gradient(66.77deg,#d83333,#f041ff)]">
          Equipo de Colaboradores
        </h2>
        <div class="mx-auto mt-2 h-px w-40 bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

        <div class="mt-6 flex flex-col items-start gap-8 lg:flex-row">
          <p class="lg:w-1/2 text-center lg:text-left text-white/85 leading-relaxed">
            Esta aplicación fue posible gracias al talento y dedicación de nuestro equipo de desarrollo:
          </p>

          <ul class="lg:w-1/2 grid grid-cols-2 sm:grid-cols-3 gap-6">
            <!-- Jonatan -->
            <li class="text-center group">
              <div class="relative mx-auto w-24 h-24">
                <!-- halo sutil -->
                <div aria-hidden="true"
                    class="absolute inset-0 rounded-full blur-sm opacity-60 transition group-hover:opacity-90
                            bg-[conic-gradient(from_140deg,rgba(216,51,51,.55),rgba(240,65,255,.55))]"></div>
                <!-- avatar -->
                <img src="https://avatars.githubusercontent.com/u/5728020?v=4" alt="Jonatan Lara"
                    class="relative z-10 w-24 h-24 rounded-full object-cover ring-2 ring-white/15 transition group-hover:ring-white/30"
                    loading="lazy" decoding="async" />
                <!-- botón GitHub SIEMPRE visible -->
                <a href="https://github.com/jonatanLara" target="_blank" aria-label="GitHub de Jonatan Lara"
                  class="absolute -bottom-1.5 -right-1.5 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full
                          text-white shadow-md ring-2 ring-white/25 transition hover:scale-110 active:scale-95
                          bg-[linear-gradient(66.77deg,#d83333,#f041ff)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                    <path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/>
                  </svg>
                </a>
              </div>
              <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-xs text-white/85 ring-1 ring-white/10">
                @jonatanLara
              </p>
            </li>

            <!-- Juan José -->
            <li class="text-center group">
              <div class="relative mx-auto w-24 h-24">
                <div aria-hidden="true"
                    class="absolute inset-0 rounded-full blur-sm opacity-60 transition group-hover:opacity-90
                            bg-[conic-gradient(from_140deg,rgba(216,51,51,.55),rgba(240,65,255,.55))]"></div>
                <img src="https://avatars.githubusercontent.com/u/117763193?v=4" alt="Juan José"
                    class="relative z-10 w-24 h-24 rounded-full object-cover ring-2 ring-white/15 transition group-hover:ring-white/30"
                    loading="lazy" decoding="async" />
                <a href="https://github.com/juanjose1930" target="_blank" aria-label="GitHub de Juan José"
                  class="absolute -bottom-1.5 -right-1.5 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full
                          text-white shadow-md ring-2 ring-white/25 transition hover:scale-110 active:scale-95
                          bg-[linear-gradient(66.77deg,#d83333,#f041ff)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/></svg>
                </a>
              </div>
              <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-xs text-white/85 ring-1 ring-white/10">
                @juanjose1930
              </p>
            </li>

            <!-- Carlos Pérez -->
            <li class="text-center group">
              <div class="relative mx-auto w-24 h-24">
                <div aria-hidden="true" class="absolute inset-0 rounded-full blur-sm opacity-60 transition group-hover:opacity-90
                            bg-[conic-gradient(from_140deg,rgba(216,51,51,.55),rgba(240,65,255,.55))]"></div>
                <img src="https://avatars.githubusercontent.com/u/73508867?v=4" alt="Carlos Pérez"
                    class="relative z-10 w-24 h-24 rounded-full object-cover ring-2 ring-white/15 transition group-hover:ring-white/30"
                    loading="lazy" decoding="async" />
                <a href="https://github.com/carlosperezse" target="_blank" aria-label="GitHub de Carlos Pérez"
                  class="absolute -bottom-1.5 -right-1.5 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full
                          text-white shadow-md ring-2 ring-white/25 transition hover:scale-110 active:scale-95
                          bg-[linear-gradient(66.77deg,#d83333,#f041ff)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/></svg>
                </a>
              </div>
              <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-xs text-white/85 ring-1 ring-white/10">
                @carlosperezse
              </p>
            </li>

            <!-- David Quime -->
            <li class="text-center group">
              <div class="relative mx-auto w-24 h-24">
                <div aria-hidden="true" class="absolute inset-0 rounded-full blur-sm opacity-60 transition group-hover:opacity-90
                            bg-[conic-gradient(from_140deg,rgba(216,51,51,.55),rgba(240,65,255,.55))]"></div>
                <img src="https://avatars.githubusercontent.com/u/211899468?v=4" alt="David Quime"
                    class="relative z-10 w-24 h-24 rounded-full object-cover ring-2 ring-white/15 transition group-hover:ring-white/30"
                    loading="lazy" decoding="async" />
                <a href="https://github.com/dquime02" target="_blank" aria-label="GitHub de David Quime"
                  class="absolute -bottom-1.5 -right-1.5 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full
                          text-white shadow-md ring-2 ring-white/25 transition hover:scale-110 active:scale-95
                          bg-[linear-gradient(66.77deg,#d83333,#f041ff)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/></svg>
                </a>
              </div>
              <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-xs text-white/85 ring-1 ring-white/10">
                @dquime02
              </p>
            </li>

            <!-- Jose Villanueva -->
            <li class="text-center group">
              <div class="relative mx-auto w-24 h-24">
                <div aria-hidden="true" class="absolute inset-0 rounded-full blur-sm opacity-60 transition group-hover:opacity-90
                            bg-[conic-gradient(from_140deg,rgba(216,51,51,.55),rgba(240,65,255,.55))]"></div>
                <img src="https://avatars.githubusercontent.com/u/54222990?v=4" alt="Jose Villanueva"
                    class="relative z-10 w-24 h-24 rounded-full object-cover ring-2 ring-white/15 transition group-hover:ring-white/30"
                    loading="lazy" decoding="async" />
                <a href="https://github.com/joselsvp" target="_blank" aria-label="GitHub de Jose Villanueva"
                  class="absolute -bottom-1.5 -right-1.5 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full
                          text-white shadow-md ring-2 ring-white/25 transition hover:scale-110 active:scale-95
                          bg-[linear-gradient(66.77deg,#d83333,#f041ff)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/></svg>
                </a>
              </div>
              <p class="mt-3 inline-flex items-center gap-1 rounded-full bg-white/10 px-3 py-1 text-xs text-white/85 ring-1 ring-white/10">
                @joselsvp
              </p>
            </li>
          </ul>
        </div>
      </section>

      <!-- Descarga y Preparación -->
      <section id="instalacion" class="bg-white/5 p-6 rounded-xl shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-blue-400 border-b border-blue-600 pb-2 mb-6">Descarga y Preparación de la Aplicación</h2>

        <div class="grid gap-6 md:grid-cols-3">
          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">1</span>
              Descargar la aplicación
            </h3>
            <p class="text-gray-300">Obtén el archivo ZIP de la aplicación desde la fuente proporcionada.</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">2</span>
              Descomprimir el archivo
            </h3>
            <p class="text-gray-300">Extrae el contenido del ZIP. Se creará una carpeta llamada <strong class="text-white">Boveda</strong>.</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">3</span>
              Estructura de carpetas
            </h3>
            <p class="text-gray-300">Dentro de <strong class="text-white">Boveda</strong> encontrarás:</p>
            <ul class="list-disc list-inside text-gray-300">
              <li>Carpeta <strong class="text-white">jre</strong> (no eliminar)</li>
              <li>Ejecutable <strong class="text-white">boveda.exe</strong></li>
            </ul>
          </div>
        </div>

        <div class="mt-6 bg-yellow-200/20 text-yellow-100 border-l-4 border-yellow-400 p-4 rounded-lg">
          <p><strong class="text-white">Importante:</strong> No elimines la carpeta JRE, ya que contiene componentes necesarios para que la aplicación funcione correctamente.</p>
        </div>
      </section>

      <!-- Preparación del Disco -->
      <section id="preparacion" class="bg-white/5 p-6 rounded-xl shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-blue-400 border-b border-blue-600 pb-2 mb-6">Preparación del Disco Duro</h2>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">1</span>
              Crear carpeta principal
            </h3>
            <p class="text-gray-300">En la raíz de la unidad, crea una carpeta con el <strong class="text-white">número de serie</strong> del disco (ej. <em>HDD-SN-5X8A9B</em>).</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">2</span>
              Organizar archivos
            </h3>
            <p class="text-gray-300">Coloca <strong class="text-white">todas</strong> las carpetas y archivos a respaldar <strong class="text-white">dentro</strong> de esa carpeta.</p>
          </div>
        </div>

        <pre class="mt-6 bg-gray-900 text-gray-200 rounded-lg p-4 overflow-x-auto text-sm">
    <code>Disco Duro (E:)
    └── 📁 HDD-SN-5X8A9B/ &lt;-- Carpeta con el N° de Serie
        ├── 📁 Proyectos_2024
        ├── 📁 Informes_Finales
        └── 📄 Manual_Procedimientos.pdf</code>
        </pre>
      </section>

      <!-- Ejecución -->
      <section id="ejecucion" class="bg-white/5 p-6 rounded-xl shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-blue-400 border-b border-blue-600 pb-2 mb-6">Ejecución de la Aplicación</h2>

        <div class="grid gap-6 md:grid-cols-3">
          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">1</span>
              Iniciar la aplicación
            </h3>
            <p class="text-gray-300">Haz doble clic en <strong class="text-white">boveda.exe</strong>.</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">2</span>
              Completar el formulario
            </h3>
            <ul class="list-disc list-inside text-gray-300 space-y-1">
              <li><strong class="text-white">N.S DE LA UNIDAD</strong></li>
              <li><strong class="text-white">COORDINACIÓN/SUBPÁREA</strong></li>
              <li><strong class="text-white">Nombre del responsable</strong></li>
              <li><strong class="text-white">Link:</strong> https://app.tree.ulmu-tm.com/</li>
            </ul>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">3</span>
              Seleccionar carpeta
            </h3>
            <p class="text-gray-300">Clic en <strong class="text-white">"Buscar Carpeta"</strong> y elige la carpeta con el número de serie.</p>
          </div>
        </div>
      </section>

      <!-- Análisis -->
      <section id="analisis" class="bg-white/5 p-6 rounded-xl shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-blue-400 border-b border-blue-600 pb-2 mb-6">Análisis y Generación de Archivos</h2>

        <div class="grid gap-6 md:grid-cols-3">
          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">1</span>
              Ejecutar análisis
            </h3>
            <p class="text-gray-300">Clic en <strong class="text-white">"Ejecutar Análisis"</strong>.</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">2</span>
              Guardar resultados
            </h3>
            <p class="text-gray-300">Elige la ubicación para guardar los archivos generados.</p>
          </div>

          <div class="bg-gray-700 p-5 rounded-lg border-l-4 border-blue-500">
            <h3 class="flex items-center font-semibold text-white mb-2">
              <span class="bg-blue-500 w-7 h-7 rounded-full flex items-center justify-center mr-2">3</span>
              Archivos generados
            </h3>
            <ul class="list-disc list-inside text-gray-300">
              <li><strong class="text-white">PDF</strong> – Resumen del análisis</li>
              <li><strong class="text-white">JSON</strong> – Estructura completa del árbol</li>
            </ul>
          </div>
        </div>

        <div class="mt-6 bg-yellow-200/20 text-yellow-100 border-l-4 border-yellow-400 p-4 rounded-lg">
          <p><strong class="text-white">Importante:</strong> Mantén estos archivos visibles para futuras consultas.</p>
        </div>
      </section>

      <!-- Resultados / Visualizador -->
      <section id="resultados" class="bg-white/5 p-6 rounded-xl shadow-sm mb-8">
        <h2 class="text-xl font-semibold text-blue-400 border-b border-blue-600 pb-2 mb-4">Visualización de Resultados</h2>
        <p class="text-gray-300">Puedes visualizar el contenido del archivo JSON generado en el sitio web:</p>


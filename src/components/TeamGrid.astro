---
/** Tipos */
interface Member {
  name: string;
  username: string;
  avatarUrl: string;
  githubUrl: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  members: Member[];
}

const {
  title = "Equipo de Colaboradores",
  subtitle = "Esta aplicación fue posible gracias al trabajo del siguiente equipo de desarrolladores:",
  members,
} = Astro.props as Props;
---
<section class="mx-auto max-w-6xl px-4 py-10">
  <div class="mb-6">
    <h2 class="text-2xl font-semibold text-space-900 dark:text-space-100">
      {title}
    </h2>
    <div class="mt-2 h-0.5 w-56 bg-space-200 dark:bg-space-800/60"></div>
    <p class="mt-4 text-space-700 dark:text-space-200/90">
      {subtitle}
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
    {members.map((m: Member) => (
      <article class="group rounded-2xl border border-white/10 bg-white/5 p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-[0_10px_40px_rgba(168,85,247,.18)] hover:ring-1 hover:ring-fuchsia-400/30">
        <div class="mx-auto mb-4 size-24 overflow-hidden rounded-full ring-2 ring-white/20 transition group-hover:ring-white/40">
          <img
            src={m.avatarUrl}
            alt={`Foto de perfil de ${m.name}`}
            class="h-full w-full object-cover" />
        </div>

        <p class="text-sm text-space-600 dark:text-space-200/80 text-center">@{m.username}</p>
        <h3 class="mt-1 text-lg font-semibold text-space-900 dark:text-white text-center">
          {m.name}
        </h3>

        <a
          href={m.githubUrl}
          target="_blank"
          class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-space-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-space-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-aurora-500 dark:bg-gradient-to-r dark:from-space-800 dark:to-space-600 dark:hover:from-space-700 dark:hover:to-space-500">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
            <path d="M12 1C5.9 1 1 5.9 1 12c0 4.9 3.1 9 7.5 10.4.6.1.8-.2.8-.5 0-.3 0-1.1 0-2-2.8.5-3.5-.7-3.7-1.3-.1-.3-.7-1.3-1.1-1.6-.4-.2-.9-.7 0-.7.9 0 1.5.8 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.4-.3-5-.1-5-5.3 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1.9-.3 1.8-.4 2.7-.4.9 0 1.9.1 2.7.4 2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.2-2.6 5.2-5 5.5.4.3.7 1 .7 2 0 1.5 0 2.7 0 3 0 .3.2.6.8.5C19.9 21 23 16.9 23 12 23 5.9 18.1 1 12 1Z"/>
          </svg>
          GitHub
        </a>
      </article>
    ))}
  </div>
</section>

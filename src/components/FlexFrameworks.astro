---
/** Tipos */
type FWName = 'React' | 'Vue' | 'Preact' | 'Svelte' | 'Solid';
interface Framework { name: FWName; href?: string }

export interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaLabel?: string;
  frameworks?: Framework[];
  active?: FWName;
}

const {
  eyebrow = "Maximum Flexibility",
  title = "Zero Lock-in",
  description = "Astro supports every major UI framework. Bring your existing components and take advantage of Astro’s optimized client build performance.",
  ctaLabel = "Integrate your favorite framework",
  frameworks = [
    { name: "React",  href: "#" },
    { name: "Vue",    href: "#" },
    { name: "Preact", href: "#" },
    { name: "Svelte", href: "#" },
    { name: "Solid",  href: "#" },
  ],
  active = "React",
} = Astro.props as Props;

const isActive = (n: FWName) => n === active;
---

<section class="mx-auto max-w-6xl px-4 py-14">
  <!-- Eyebrow -->
  <p class="text-sm font-medium tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-red-700 to-indigo-500 bg-clip-text text-transparent">
    {eyebrow}
  </p>

  <!-- Title -->
  <h2 class="mt-1 text-4xl md:text-5xl font-semibold leading-tight text-white">
    {title}
  </h2>

  <!-- Description -->
  <p class="mt-4 max-w-3xl text-[15px] text-white/80">
    {description}
  </p>

  <!-- CTA pill -->
  <div class="mt-6">
    <a
      href="#"
      class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-[15px] text-white/90 shadow-sm backdrop-blur transition hover:bg-white/10"
    >
      {ctaLabel}
    </a>
  </div>

  <!-- Framework pills -->
  <ul class="mt-8 flex flex-wrap gap-4">
    {frameworks.map((fw) => (
      <li>
        <a
          href={fw.href ?? "#"}
          class={[
            "flex w-[92px] flex-col items-center gap-2 rounded-full border px-3 py-3 transition",
            "border-white/15 bg-white/5 backdrop-blur",
            isActive(fw.name)
              ? "ring-2 ring-cyan-400/70 shadow-[0_0_28px_rgba(34,211,238,.25)]"
              : "opacity-90 hover:bg-white/10"
          ].join(" ")}
        >
          <!-- Icon -->
          {
            fw.name === "React" && (
              <svg viewBox="0 0 24 24" class={["h-9 w-9", isActive(fw.name) ? "text-cyan-300" : "text-white/70"].join(" ")} fill="currentColor" aria-hidden="true">
                <path d="M12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"/><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2c1.4 0 2.9.3 4.5.9 1.6.6 3 1.3 4 2.1 1 .8 1.5 1.6 1.5 2.4s-.5 1.6-1.5 2.4c-1 .8-2.3 1.5-4 2.1-1.6.6-3.1.9-4.5.9s-2.9-.3-4.5-.9c-1.6-.6-3-1.3-4-2.1C-.5 9 0 8.2 0 7.4S-.5 5.8.5 5c1-.8 2.3-1.5 4-2.1C9.1 2.3 10.6 2 12 2Zm0 20c-1.4 0-2.9-.3-4.5-.9-1.6-.6-3-1.3-4-2.1-1-.8-1.5-1.6-1.5-2.4s.5-1.6 1.5-2.4c1-.8 2.3-1.5 4-2.1 1.6-.6 3.1-.9 4.5-.9s2.9.3 4.5.9c1.6.6 3 1.3 4 2.1 1 .8 1.5 1.6 1.5 2.4s-.5 1.6-1.5 2.4c-1 .8-2.3 1.5-4 2.1-1.6.6-3.1.9-4.5.9Z" opacity=".25"/>
              </svg>
            )
          }
          {fw.name === "Vue" && (
            <svg viewBox="0 0 128 128" class={["h-9 w-9", isActive(fw.name) ? "text-white" : "text-white/70"].join(" ")} fill="currentColor"><path d="M78.8 10.7H49.2L9.4 78.6l19.9 34.7 49.5-86.5 49.9 86.5L149 78.6z" opacity=".2"/></svg>
          )}
          {fw.name === "Preact" && (
            <svg viewBox="0 0 24 24" class={["h-9 w-9", isActive(fw.name) ? "text-white" : "text-white/70"].join(" ")} fill="currentColor"><path d="M12 2c5.5 0 10 4.5 10 10s-4.5 10-10 10S2 17.5 2 12 6.5 2 12 2Z" opacity=".2"/></svg>
          )}
          {fw.name === "Svelte" && (
            <svg viewBox="0 0 256 256" class={["h-9 w-9", isActive(fw.name) ? "text-white" : "text-white/70"].join(" ")} fill="currentColor"><path d="M128 16 32 64v128l96 48 96-48V64Z" opacity=".2"/></svg>
          )}
          {fw.name === "Solid" && (
            <svg viewBox="0 0 256 256" class={["h-9 w-9", isActive(fw.name) ? "text-white" : "text-white/70"].join(" ")} fill="currentColor"><path d="M208 96 128 48 48 96l80 48z" opacity=".2"/></svg>
          )}
          <!-- Label -->
          <span class={["text-[13px] font-medium", isActive(fw.name) ? "text-cyan-300" : "text-white/80"].join(" ")}>
            {fw.name}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
